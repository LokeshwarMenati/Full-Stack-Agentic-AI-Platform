# NEXUS AI — Environment Configuration
# Copy this file to .env and adjust variables as needed

# Application Environment
APP_ENV=development
APP_NAME="NEXUS AI — Enterprise Intelligent Assistant"
APP_HOST=127.0.0.1
APP_PORT=8000
FRONTEND_ORIGIN=http://localhost:5173

# Database & Checkpoint Persistence
DATABASE_URL=sqlite+aiosqlite:///./data/nexus.db
SYNC_DATABASE_URL=sqlite:///./data/nexus.db
CHECKPOINT_DATABASE_PATH=./data/checkpoints.db

# LLM Provider Configuration
# Supported options: mock | groq | gemini
# "mock" provides deterministic, zero-cost offline responses for testing and assessment evaluation
LLM_PROVIDER=mock
LLM_MODEL=nexus-dev-deterministic

# API Keys (Required only if LLM_PROVIDER is groq or gemini)
GROQ_API_KEY=gsk_your_groq_api_key_here
GOOGLE_API_KEY=AIzaSy_your_gemini_api_key_here

# Embeddings & Vector Store Configuration
# Supported options: local | gemini
# "local" uses dense normalized TF-IDF offline index (zero API credentials needed)
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=tfidf-dense-normalized
VECTOR_STORE_PATH=./data/vector_store

# Document Paths
PRIMARY_DOCUMENT_PATH=./data/documents/employee_handbook.pdf
SECONDARY_DOCUMENT_PATH=./data/documents/Northwind_Standard_Benefits_Details.pdf

# Regional & Logging Configuration
TIMEZONE=Asia/Kolkata
LOG_LEVEL=INFO
